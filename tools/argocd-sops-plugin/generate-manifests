#!/bin/sh
set -eu

files=$(find . -type f -name '*.sops.yaml' -print | LC_ALL=C sort)
if [ -z "$files" ]; then
  echo "No *.sops.yaml files found." >&2
  exit 1
fi

first=true
printf '%s\n' "$files" | while IFS= read -r file; do
  if [ "$first" = false ]; then
    printf '%s\n' '---'
  fi
  sops --decrypt --output-type yaml "$file"
  first=false
done
